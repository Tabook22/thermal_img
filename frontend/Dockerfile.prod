FROM node:22-alpine AS build
WORKDIR /app
COPY package.json pnpm-lock.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile
COPY . .
ARG VITE_BASE_PATH=/thermal/
ENV VITE_BASE_PATH=${VITE_BASE_PATH}
RUN pnpm build

FROM nginxinc/nginx-unprivileged:stable-alpine
COPY --from=build /app/dist /usr/share/nginx/html/thermal
COPY --chown=nginx:nginx --chmod=0644 nginx.prod.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
