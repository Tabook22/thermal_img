FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && groupadd --system --gid 10001 thermal \
    && useradd --system --uid 10001 --gid thermal --home-dir /app thermal \
    && mkdir -p /data \
    && chown thermal:thermal /data
COPY --chown=thermal:thermal alembic.ini ./
COPY --chown=thermal:thermal alembic ./alembic
COPY --chown=thermal:thermal app ./app
USER thermal
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--proxy-headers", "--forwarded-allow-ips", "*"]
